FROM gradle:9.7.0-jdk25 AS build
WORKDIR /workspace
COPY . .
RUN gradle :chronos-device-gateway:bootJar --no-daemon

FROM eclipse-temurin:25-jre
WORKDIR /app
COPY --from=build /workspace/chronos-device-gateway/build/libs/chronos-device-gateway-*.jar app.jar
EXPOSE 9100
ENTRYPOINT ["java","-jar","/app/app.jar"]
